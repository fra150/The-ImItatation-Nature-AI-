# ===========================================================================
# The ImItatation Nature AI — environment template
# Copia questo file in `.env` e compila i valori. `.env` NON va committato.
# ===========================================================================

# --- Server ---------------------------------------------------------------
# Porta del backend (default 3000). NB: su questa macchina :3000 è occupato da
# Grafana -> usa una porta libera, es. 3001 (e allinea il frontend, in fondo).
PORT=3000

# --- Database -------------------------------------------------------------
# Default: SQLite (zero setup, file database.sqlite, gitignored). Il server si
# avvia anche senza DB (connessione best-effort). Per produzione: DB_DIALECT=mysql.
DB_DIALECT=sqlite
# DB_STORAGE=./database.sqlite        # path del file SQLite (opzionale)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=imitation_nature_ai
# DB_USER=root
# DB_PASS=

# --- Auth (OBBLIGATORIO) --------------------------------------------------
# Segreto JWT: usato SIA dalle route HTTP SIA dall'handshake Socket.io.
JWT_SECRET=change-me-to-a-long-random-string

# --- MQTT / IoT (OPZIONALE) -----------------------------------------------
# Bus per droni e sensori. Senza, l'IoT gateway resta in "degraded mode"
# (nessun device via MQTT; i publish dei comandi sono no-op). Es. Mosquitto:
# MQTT_BROKER_URL=mqtt://localhost:1883
# Topic: drones/{id}/{telemetry,status,ack,commands}, sensors/{id}/telemetry
FIRE_TEMP_THRESHOLD=60
FIRE_SMOKE_THRESHOLD=70

# --- Salute della connessione droni (WiFi/radio) --------------------------
# Un drone senza telemetria da più di questo tempo viene dichiarato offline
# (watchdog lato backend, indipendente dal broker); il watchdog gira ogni
# OFFLINE_WATCHDOG_INTERVAL_MS. Segnale sotto soglia -> evento drone:weak-signal.
DRONE_OFFLINE_TIMEOUT_MS=30000
OFFLINE_WATCHDOG_INTERVAL_MS=10000
WEAK_SIGNAL_RSSI_DBM=-80
WEAK_SIGNAL_LINK_QUALITY=30

# --- Earth Engine (FUNZIONANTE) -------------------------------------------
# Service-account key (path; il file va in secrets/, gitignored).
EE_SERVICE_ACCOUNT_KEY=./secrets/ee-key.json
EE_PROJECT=ee-150francescobulla

# --- Gemini (OPZIONALE) ---------------------------------------------------
# Senza chiave, /gemini risponde 503 (graceful).
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Notifiche email (OPZIONALE) ------------------------------------------
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL_RECIPIENT=
NOTIFICATION_EMAIL_SUBJECT=Fire Event Notification

# --- ML training (tfjs-node; default ragionevoli se non impostati) --------
MODEL_PATH=
SAVE_PATH=
EPOCHS=50

# ===========================================================================
# Frontend (file separato: frontend/.env.local)
# Se il backend NON è su :3000, puntalo qui:
#   VITE_API_URL=http://localhost:3001
# ===========================================================================
