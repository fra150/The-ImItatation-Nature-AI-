# ===========================================================================
# The ImItatation Nature AI — environment template
# Copia questo file in `.env` e compila i valori. `.env` NON va committato.
# ===========================================================================

# --- Server ---------------------------------------------------------------
PORT=3000

# --- Database (MySQL via Sequelize) — necessario per gli endpoint core -----
# Il server si avvia anche senza DB raggiungibile (connessione best-effort),
# ma gli endpoint che leggono/scrivono dati falliranno finché non è configurato.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=imitation_nature_ai
DB_USER=root
DB_PASS=
DB_DRIVER=mysql

# --- Auth (necessario per /auth/login) ------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- MQTT (OPZIONALE) ------------------------------------------------------
# Se non impostato, l'integrazione MQTT viene saltata (nessun loop di reconnect).
# MQTT_BROKER_URL=mqtt://localhost:1883

# --- Notifiche email (OPZIONALE) ------------------------------------------
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL_RECIPIENT=
NOTIFICATION_EMAIL_SUBJECT=Fire Event Notification

# --- Feature AI / Earth Engine (attualmente DISABILITATE -> 501) ----------
# Richieste solo per riattivare /gemini, /drones, forest, /api/weather.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# --- ML training (tfjs-node) ----------------------------------------------
# Hanno default ragionevoli se non impostati.
MODEL_PATH=
SAVE_PATH=
EPOCHS=50
